#!/bin/bash
source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"
export PLUGIN_DIR
rm -f "${TMPDIR:-/tmp}/sketchybar_open_popup"   # popup state always starts clean

# ---- Bar: floating, blurred, neon ----
sketchybar --bar \
  height=30 \
  position=top \
  sticky=on \
  topmost=on \
  show_in_fullscreen=on \
  margin=0 \
  y_offset=0 \
  corner_radius=0 \
  blur_radius=30 \
  shadow=off \
  color=$BAR_COLOR \
  padding_left=10 \
  padding_right=10

# ---- Defaults for all items ----
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Bold:15.0" \
  icon.color=$WHITE \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.font="JetBrainsMono Nerd Font:Bold:12.0" \
  label.color=$WHITE \
  label.padding_left=4 \
  label.padding_right=8 \
  background.color=$ITEM_BG_COLOR \
  background.corner_radius=8 \
  background.height=24 \
  background.border_width=1 \
  background.border_color=$TRANSPARENT \
  padding_left=4 \
  padding_right=4 \
  updates=on

# ---- Items (right side: first sourced = rightmost) ----
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/theme_picker.sh"
source "$ITEM_DIR/widgets_menu.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"
source "$ITEM_DIR/meeting.sh"

source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/stats.sh"       # ram + cpu bracket
source "$ITEM_DIR/temps.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/network.sh"
source "$ITEM_DIR/weather.sh"
source "$ITEM_DIR/github.sh"
source "$ITEM_DIR/pomodoro.sh"
source "$ITEM_DIR/caffeine.sh"
source "$ITEM_DIR/speedtest.sh"
source "$ITEM_DIR/focus.sh"
source "$ITEM_DIR/ports.sh"
source "$ITEM_DIR/clipboard.sh"
source "$ITEM_DIR/aura.sh"
source "$ITEM_DIR/journal.sh"
source "$ITEM_DIR/ai_agents.sh"
source "$ITEM_DIR/media.sh"
source "$ITEM_DIR/fs_guard.sh"
source "$ITEM_DIR/click_watch.sh"

sketchybar --update
